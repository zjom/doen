#compdef doen
# zsh completion for doen: the candidates come from doen itself.

_doen() {
    local -a lines cands
    local l
    lines=(${(f)"$(doen __complete line -- "${(@)words[2,CURRENT-1]}" "${words[CURRENT]}" 2>/dev/null)"})
    for l in $lines; do
        # `value<TAB>help` becomes `value:help`, with the colons of the value escaped.
        if [[ $l == *$'\t'* ]]; then
            cands+=("${${l%%$'\t'*}//:/\\:}:${l#*$'\t'}")
        else
            cands+=("${l//:/\\:}")
        fi
    done
    _describe 'doen' cands
}

_doen "$@"
